# Consolidate the root to the default-language page with a permanent 301
# (was a 302 soft-redirect, which leaked link equity and got / indexed separately).
/             /km/   301
/index.html   /km/   301

# Normalise no-slash language entry points to the canonical trailing-slash form.
/km   /km/   301
/en   /en/   301
/zh   /zh/   301

