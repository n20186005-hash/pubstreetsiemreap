---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicPage from '../../components/TopicPage.astro';
import { siteConfig } from '../../config';
import { TOPICS } from '../../data/topics';
import { getLocalizedTopic } from '../../data/topics-i18n';

export function getStaticPaths() {
  return (['en', 'zh', 'km'] as const).flatMap((lang) => TOPICS.map((t) => ({
    params: { lang, topic: t.slug },
  })));
}

const { topic, lang } = Astro.params as { topic: string; lang: 'en' | 'zh' | 'km' };
const t = getLocalizedTopic(lang, topic);
if (!t) return Astro.redirect(`/${lang}/`);

const SITE = siteConfig.baseUrl;
const canonical = `${SITE}/${lang}/${t.slug}/`;
const alternates = { en: `${SITE}/en/${t.slug}/`, zh: `${SITE}/zh/${t.slug}/`, km: `${SITE}/km/${t.slug}/`, xDefault: `${SITE}/en/${t.slug}/` };
---

<BaseLayout
  path={t.slug}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternates}
  noJsonLd={true}
>
  <TopicPage topic={t} canonical={canonical} lang={lang} />
</BaseLayout>
