---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAttractions } from '../../../data/attractions-i18n';
import { getAttractionPractical } from '../../../data/attraction-practical';
import { siteConfig } from '../../../config';

export function getStaticPaths() {
  return (['en', 'zh', 'km'] as const).flatMap((lang) => getAttractions(lang).map((place) => ({ params: { lang, slug: place.slug }, props: { place, lang } })));
}
const { place, lang } = Astro.props;
const factSources = place.factSources ?? [];
const practical = getAttractionPractical(place.slug, lang);
const labels = {
  en: { district:'Explore Siem Reap · Nearby Places', map:'View this place on Google Maps ↗', discover:'Discover', about:'About', managed:'Who looks after it?', basic:'Basic information', location:'Location', admission:'Admission', admissionText:'Public areas are generally free; purchases and events may cost extra.', opening:'Opening', openingText:'Confirm the current schedule and access rules on site.', tips:'Visit tips', photo:'Location-specific photograph', source:'Photo source ↗', context:'History, architecture and local culture', history:'History', architecture:'Architecture and setting', culture:'Cultural context', notice:'What to notice', route:'Suggested walking route', photography:'Photography tips', faq:'Frequently asked questions', directions:'Directions and location', openMap:'Open this place in Google Maps ↗', back:'Explore nearby places', suffix:'Siem Reap Visitor Guide' },
  zh: { district:'探索暹粒 · 周边景点', map:'在 Google 地图查看此地点 ↗', discover:'探索', about:'关于', managed:'谁负责管理维护？', basic:'基本信息', location:'地址', admission:'门票', admissionText:'普通公共区域通常免费，购物或活动可能另行收费。', opening:'开放时间', openingText:'请在现场核实最新时间及进入规则。', tips:'游览建议', photo:'对应地点实景照片', source:'照片来源 ↗', context:'历史、建筑与当地文化', history:'历史背景', architecture:'建筑及环境特色', culture:'文化意义', notice:'观察重点', route:'建议步行路线', photography:'拍摄机位与建议', faq:'常见问题', directions:'交通指南与位置', openMap:'在 Google 地图打开此地点 ↗', back:'返回周边景点', suffix:'暹粒旅行指南' },
  km: { district:'ស្វែងយល់ពីសៀមរាប · ទីកន្លែងក្បែរៗ', map:'មើលទីតាំងនេះលើ Google Maps ↗', discover:'ស្វែងយល់ពី', about:'អំពី', managed:'អ្នកណាគ្រប់គ្រង និងថែទាំ?', basic:'ព័ត៌មានមូលដ្ឋាន', location:'អាសយដ្ឋាន', admission:'ថ្លៃចូល', admissionText:'ជាទូទៅតំបន់សាធារណៈមិនគិតថ្លៃ ប៉ុន្តែទំនិញនិងកម្មវិធីអាចមានតម្លៃ។', opening:'ម៉ោងបើក', openingText:'សូមពិនិត្យម៉ោង និងលក្ខខណ្ឌចូលនៅទីតាំងផ្ទាល់។', tips:'គន្លឹះសម្រាប់ភ្ញៀវ', photo:'រូបថតទីតាំងពិត', source:'ប្រភពរូបថត ↗', context:'ប្រវត្តិ ស្ថាបត្យកម្ម និងវប្បធម៌', history:'ប្រវត្តិ', architecture:'ស្ថាបត្យកម្ម និងបរិយាកាស', culture:'បរិបទវប្បធម៌', notice:'ចំណុចគួរសង្កេត', route:'ផ្លូវដើរណែនាំ', photography:'គន្លឹះថតរូប', faq:'សំណួរញឹកញាប់', directions:'ផ្លូវទៅ និងទីតាំង', openMap:'បើកទីតាំងនេះលើ Google Maps ↗', back:'ត្រឡប់ទៅទីកន្លែងក្បែរៗ', suffix:'មគ្គុទ្ទេសក៍ទេសចរណ៍សៀមរាប' },
}[lang as 'en' | 'zh' | 'km'];
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.mapQuery)}`;
const copy = {
  en: { type:'Attraction type', duration:'Suggested time', schedule:'Opening hours', cost:'Ticket prices', access:'Getting here', walking:'From Pub Street', aboutVisit:'Visitor advice', features:'Attraction highlights', experience:'Signature experience', stay:'Where to stay', reviews:'Visitor reviews', reviewsText:'See current traveller ratings, review counts and individual accounts on the place-specific Google Maps listing. This guide does not publish an unverified rating or reproduce individual reviews.', etiquette:'Visitor guidelines', plan:'Plan your visit', mapNote:'The link searches for this exact attraction by name and location. A verified Google Place ID is not yet available.', logistics:'Travel essentials' },
  zh: { type:'景点类型', duration:'建议停留', schedule:'开放时间', cost:'门票价格', access:'交通方式', walking:'从酒吧街出发', aboutVisit:'游览建议', features:'景区特色', experience:'核心体验', stay:'住宿建议', reviews:'游客评价', reviewsText:'可通过该地点专属 Google 地图页面查看最新游客评分、评价数量与原文。本站不展示未经逐一核实的评分，也不复制个人评论。', etiquette:'游览须知', plan:'规划行程', mapNote:'此链接按景点名称和所在地专属搜索；目前尚未取得核实过的 Google Place ID。', logistics:'旅行基础资料' },
  km: { type:'ប្រភេទទីកន្លែង', duration:'រយៈពេលណែនាំ', schedule:'ម៉ោងបើក', cost:'តម្លៃសំបុត្រ', access:'របៀបទៅដល់', walking:'ពីផាប់ស្ទ្រីត', aboutVisit:'ការណែនាំទស្សនា', features:'ចំណុចពិសេស', experience:'បទពិសោធន៍សំខាន់', stay:'យោបល់កន្លែងស្នាក់នៅ', reviews:'មតិភ្ញៀវ', reviewsText:'អាចមើលពិន្ទុ ចំនួនមតិ និងមតិពិតថ្មីៗនៅ Google Maps សម្រាប់ទីតាំងនេះ។ គេហទំព័រនេះមិនបង្ហាញពិន្ទុដែលមិនទាន់បានផ្ទៀងផ្ទាត់ ឬចម្លងមតិបុគ្គលទេ។', etiquette:'សេចក្ដីណែនាំសម្រាប់ភ្ញៀវ', plan:'រៀបចំដំណើរ', mapNote:'តំណនេះស្វែងរកតាមឈ្មោះ និងទីតាំងជាក់លាក់; មិនទាន់មាន Google Place ID ដែលបានផ្ទៀងផ្ទាត់។', logistics:'ព័ត៌មានសម្រាប់ដំណើរ' },
}[lang as 'en' | 'zh' | 'km'];
const canonical = `${siteConfig.baseUrl}/${lang}/attractions/${place.slug}/`;
const alternates = Object.fromEntries((['en', 'zh', 'km'] as const).map((l) => [l, `${siteConfig.baseUrl}/${l}/attractions/${place.slug}/`]));
const ld = [
  { '@context': 'https://schema.org', '@type': 'TouristAttraction', name: place.name, description: place.introduction, address: place.address, url: canonical, sameAs: mapUrl },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Pub Street', item: `${siteConfig.baseUrl}/${lang}/` },
    { '@type': 'ListItem', position: 2, name: labels.back, item: `${siteConfig.baseUrl}/${lang}/#nearby-guides` },
    { '@type': 'ListItem', position: 3, name: place.name, item: canonical },
  ] },
];
---
<BaseLayout path={`attractions/${place.slug}`} title={`${place.name} | ${labels.suffix}`} description={`${place.subtitle} — ${place.introduction}`} noJsonLd={true} alternates={{...alternates, xDefault: alternates.en}}>
  <article>
    <section class="hero">
      <div class="hero-bg" style={`background-image:url('${place.photo}')`}></div>
      <div class="container hero-inner">
        <p class="local">{labels.district}</p>
        <h1>{place.name}</h1>
        <p class="tagline">{place.subtitle}</p>
        <div class="nearby-facts" aria-label={copy.logistics}>
          <span>{practical.type}</span><span>{copy.duration}: {practical.duration}</span><span>{practical.hours}</span>
        </div>
        <a class="btn-cta btn-cta-primary" href={mapUrl} target="_blank" rel="noopener noreferrer">{labels.map}</a>
      </div>
    </section>
    <section class="section-padding">
      <div class="container">
        <h2 class="section-title">{labels.discover} {place.name}</h2>
        <p class="section-lead">{place.introduction}</p>
        <h2 class="section-title" style="margin-top:36px">{copy.aboutVisit}</h2>
        <ul>{place.tips.map((tip) => <li>{tip}</li>)}</ul>
        <h2 class="section-title" style="margin-top:36px">{copy.features}</h2>
        <div class="nearby-grid">{place.highlights.map((point, index) => <div class="card card-pad"><h3>{String(index + 1).padStart(2, '0')}</h3><p>{point}</p></div>)}</div>
        <div class="card card-pad" style="margin-top:24px">
          <h3>{labels.about} {place.name} · {labels.managed}</h3>
          <p>{place.management}</p>
        </div>
        <div class="nearby-grid" style="margin-top:26px">
          <div class="card card-pad"><h3>{labels.basic}</h3><dl class="guide-facts"><dt>{labels.about} / {copy.type}</dt><dd>{practical.type}</dd><dt>{labels.location}</dt><dd>{place.address}</dd><dt>{copy.duration}</dt><dd>{practical.duration}</dd><dt>{labels.managed}</dt><dd>{place.management}</dd></dl></div>
          <div class="card card-pad"><h3>{copy.plan}</h3><p><strong>{copy.schedule}</strong></p><p>{practical.hours}</p><p><strong>{copy.cost}</strong></p><p>{practical.admission}</p></div>
        </div>
        <h2 class="section-title" style="margin-top:40px">{copy.access}</h2>
        <div class="card card-pad"><h3>{copy.walking}</h3><p>{practical.transport}</p><p><a class="link-accent" href={mapUrl} target="_blank" rel="noopener noreferrer">{labels.openMap}</a></p></div>
        <figure class="card" style="overflow:hidden;margin:32px 0">
          <img src={place.photo} alt={`${place.name} — ${labels.photo}`} loading="lazy" style="width:100%;max-height:520px;object-fit:cover" />
          <figcaption style="padding:12px 20px;color:var(--text-muted);font-size:.85rem">{labels.photo} · <a class="link-accent" href={place.photoSource} target="_blank" rel="noopener noreferrer">{labels.source}</a></figcaption>
        </figure>
        <h2 class="section-title">{labels.context}</h2>
        <div class="nearby-grid">
          <div class="card card-pad"><h3>{labels.history}</h3><p>{place.history}</p></div>
          <div class="card card-pad"><h3>{labels.architecture}</h3><p>{place.architecture}</p></div>
          <div class="card card-pad"><h3>{labels.culture}</h3><p>{place.culture}</p></div>
        </div>
        <h2 class="section-title" style="margin-top:40px">{copy.experience}</h2>
        <p class="section-lead">{practical.experience}</p>
        <h2 class="section-title" style="margin-top:40px">{labels.route}</h2>
        <ol>{place.route.map((step) => <li style="margin-bottom:12px">{step}</li>)}</ol>
        <h2 class="section-title" style="margin-top:40px">{copy.etiquette}</h2>
        <p class="section-lead">{place.culture}</p>
        <h2 class="section-title" style="margin-top:40px">{labels.photography}</h2>
        <p class="section-lead">{place.photoTips}</p>
        <h2 class="section-title" style="margin-top:40px">{copy.stay}</h2>
        <p class="section-lead">{practical.accommodation}</p>
        <h2 class="section-title" style="margin-top:40px">{copy.reviews}</h2>
        <div class="card card-pad"><p>{copy.reviewsText}</p><p><a class="link-accent" href={mapUrl} target="_blank" rel="noopener noreferrer">{labels.openMap}</a></p></div>
        <h2 class="section-title" style="margin-top:40px">{labels.faq}</h2>
        <div class="card card-pad">{place.faq.map((f) => <div style="margin-bottom:22px"><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
        <h2 class="section-title" style="margin-top:40px">{labels.directions}</h2>
        <p>{place.address}</p>
        <p><a class="link-accent" href={mapUrl} target="_blank" rel="noopener noreferrer">{labels.openMap}</a></p>
        <p class="guide-map-note">{copy.mapNote}</p>
        {factSources.length > 0 && <div class="card card-pad" style="margin-top:24px"><h3>{lang === 'zh' ? '资料来源与核实' : lang === 'km' ? 'ប្រភពព័ត៌មាន' : 'Sources and verification'}</h3><ul>{factSources.map((source) => <li><a class="link-accent" href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul></div>}
        <p style="margin-top:32px"><a class="link-accent" href={`/${lang}/#nearby-guides`}>← {labels.back}</a></p>
      </div>
    </section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <style>
    .nearby-facts{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 24px}
    .nearby-facts span{border:1px solid rgba(255,255,255,.45);border-radius:99px;padding:7px 12px;color:#fff;background:rgba(0,0,0,.24);font-size:.88rem}
    .guide-facts{display:grid;grid-template-columns:minmax(110px,1fr) 2fr;gap:12px 16px}
    .guide-facts dt{font-weight:700}.guide-facts dd{margin:0;overflow-wrap:anywhere}
    .guide-map-note{font-size:.88rem;color:var(--text-muted)}
    @media(max-width:600px){.guide-facts{grid-template-columns:1fr;gap:6px}.guide-facts dd{margin-bottom:14px}}
  </style>
</BaseLayout>
