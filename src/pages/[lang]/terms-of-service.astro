---
import { languagesList } from '../../i18n/ui';
import { getI18n } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalDoc from '../../components/LegalDoc.astro';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang, messages: m, t } = getI18n(Astro.url);
const title = m.legal.terms.title;
const description = m.legal.terms.sections[0].body;
---

<BaseLayout path="/terms-of-service" noJsonLd title={title} description={description}>
  <div class="legal-wrap">
    <LegalDoc lang={lang} messages={m} t={t} page="terms" />
  </div>
</BaseLayout>
