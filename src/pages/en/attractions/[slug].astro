---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ATTRACTIONS } from '../../../data/attractions';
import { siteConfig } from '../../../config';

export function getStaticPaths() {
  return ATTRACTIONS.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}
const { place } = Astro.props;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.mapQuery)}`;
const canonical = `${siteConfig.baseUrl}/en/attractions/${place.slug}/`;
const ld = [
  { '@context': 'https://schema.org', '@type': 'TouristAttraction', name: place.name, description: place.introduction, address: place.address, url: canonical, sameAs: mapUrl },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Pub Street', item: `${siteConfig.baseUrl}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Nearby attractions', item: `${siteConfig.baseUrl}/en/#nearby-guides` },
    { '@type': 'ListItem', position: 3, name: place.name, item: canonical },
  ] },
];
---
<BaseLayout path={`attractions/${place.slug}`} title={`${place.name} | Siem Reap Visitor Guide`} description={`${place.subtitle}. History, architecture, visiting tips, walking route, photographs and a location map.`} noJsonLd={true} alternates={{en: canonical, xDefault: canonical}}>
  <article>
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="container hero-inner">
        <p class="local">Explore Siem Reap · Nearby Places</p>
        <h1>{place.name}</h1>
        <p class="tagline">{place.subtitle}</p>
        <a class="btn-cta btn-cta-primary" href={mapUrl} target="_blank" rel="noopener noreferrer">View this place on Google Maps ↗</a>
      </div>
    </section>
    <section class="section-padding">
      <div class="container">
        <h2 class="section-title">Discover {place.name}</h2>
        <p class="section-lead">{place.introduction}</p>
        <div class="card card-pad" style="margin-top:24px">
          <h3>About {place.name} · Who looks after it?</h3>
          <p>{place.management}</p>
        </div>
        <div class="nearby-grid" style="margin-top:26px">
          <div class="card card-pad"><h3>Basic information</h3><p><strong>Location:</strong> {place.address}</p><p><strong>Admission:</strong> Public-area access normally free; purchases or events may cost extra.</p><p><strong>Opening:</strong> Check the current schedule and access rules on site.</p></div>
          <div class="card card-pad"><h3>Visit tips</h3><ul>{place.tips.map((tip) => <li>{tip}</li>)}</ul></div>
        </div>
        <figure class="card" style="overflow:hidden;margin:32px 0">
          <img src={place.photo} alt={`Real-world view of ${place.name} in Siem Reap`} loading="lazy" style="width:100%;max-height:520px;object-fit:cover" />
          <figcaption style="padding:12px 20px;color:var(--text-muted);font-size:.85rem">Location-specific photograph · <a class="link-accent" href={place.photoSource} target="_blank" rel="noopener noreferrer">Photo source ↗</a></figcaption>
        </figure>
        <h2 class="section-title">History, architecture and local culture</h2>
        <div class="nearby-grid">
          <div class="card card-pad"><h3>History</h3><p>{place.history}</p></div>
          <div class="card card-pad"><h3>Architecture and setting</h3><p>{place.architecture}</p></div>
          <div class="card card-pad"><h3>Cultural context</h3><p>{place.culture}</p></div>
        </div>
        <h2 class="section-title" style="margin-top:40px">What to notice</h2>
        <ul>{place.highlights.map((point) => <li>{point}</li>)}</ul>
        <h2 class="section-title" style="margin-top:40px">Suggested walking route</h2>
        <ol>{place.route.map((step) => <li style="margin-bottom:12px">{step}</li>)}</ol>
        <h2 class="section-title" style="margin-top:40px">Photography tips</h2>
        <p class="section-lead">{place.photoTips}</p>
        <h2 class="section-title" style="margin-top:40px">Frequently asked questions</h2>
        <div class="card card-pad">{place.faq.map((f) => <div style="margin-bottom:22px"><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
        <h2 class="section-title" style="margin-top:40px">Directions and location</h2>
        <p>{place.address}</p>
        <p><a class="link-accent" href={mapUrl} target="_blank" rel="noopener noreferrer">Open {place.name} in Google Maps ↗</a></p>
        <p style="margin-top:32px"><a class="link-accent" href="/en/#nearby-guides">← Explore nearby places</a></p>
      </div>
    </section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
