---
import { siteConfig } from '../config';

// Default landing is Khmer. ?lang=en / ?lang=zh switch language (handled
// client-side via localStorage + cookie so later visits land on the same one).
const param = Astro.url.searchParams.get('lang');
const next = param === 'en' || param === 'zh' ? param : 'km';

let html = `<!doctype html><html lang="${next}"><head><meta charset="utf-8">` +
  `<meta http-equiv="refresh" content="0; url=/${next}">` +
  `<link rel="canonical" href="${siteConfig.baseUrl}/${next}">` +
  `<script>try{localStorage.setItem('lang','${next}');document.cookie='lang=${next};path=/;max-age=31536000';}catch(e){}` +
  `location.replace('/${next}')</script></head><body></body></html>`;

Astro.response.headers.set('Content-Type', 'text/html; charset=utf-8');
return new Response(html);
---
