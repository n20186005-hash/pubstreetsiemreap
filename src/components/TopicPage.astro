---
import { siteConfig } from '../config';
import { type Topic } from '../data/topics';
import { getTopics } from '../data/topics-i18n';
import { mapsUrl } from '../config';

const { topic, canonical, lang } = Astro.props as {
  topic: Topic;
  canonical: string;
  lang: string;
};
const SITE = siteConfig.baseUrl;
const allTopics = getTopics(lang as 'en' | 'zh' | 'km');
const labels = {
  en: { eyebrow: 'Siem Reap Travel Guide', map: 'View the relevant area on Google Maps ↗', venues: 'Well-known venues for orientation', venueIntro: 'These names are provided as landmarks, not endorsements. Business details can change; check current opening information before visiting.', area: 'Area', faq: 'Frequently asked questions', more: 'More Siem Reap guides', back: 'Back to the Pub Street Siem Reap guide' },
  zh: { eyebrow: '暹粒旅行指南', map: '在 Google 地图查看相关地点 ↗', venues: '帮助辨认位置的知名店家', venueIntro: '以下店名仅供辨认街区，不代表本站推荐。营业与经营信息可能变化，请在现场核实。', area: '区域', faq: '常见问题', more: '更多暹粒专题', back: '返回暹粒酒吧街指南' },
  km: { eyebrow: 'មគ្គុទ្ទេសក៍ទេសចរណ៍សៀមរាប', map: 'មើលតំបន់នេះលើ Google Maps ↗', venues: 'ហាងល្បីសម្រាប់សម្គាល់ទីតាំង', venueIntro: 'ឈ្មោះហាងទាំងនេះសម្រាប់សម្គាល់ទីតាំង មិនមែនការណែនាំពាណិជ្ជកម្មទេ។ សូមពិនិត្យព័ត៌មានបច្ចុប្បន្ននៅទីតាំងផ្ទាល់។', area: 'តំបន់', faq: 'សំណួរញឹកញាប់', more: 'មគ្គុទ្ទេសក៍សៀមរាបបន្ថែម', back: 'ត្រឡប់ទៅមគ្គុទ្ទេសក៍ផាប់ស្ទ្រីត' },
}[lang as 'en' | 'zh' | 'km'];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Pub Street Siem Reap',
      item: `${SITE}/${lang}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: topic.title,
      item: canonical,
    },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faq.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: topic.title,
  description: topic.metaDescription,
  url: canonical,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Pub Street Siem Reap Guide',
    url: `${SITE}/${lang}/`,
  },
};
---

<article>
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
      <p class="local">{labels.eyebrow}</p>
      <h1>{topic.title}</h1>
      <p class="tagline">{topic.metaDescription}</p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <p class="section-lead" style="max-width:780px">{topic.intro}</p>
      <p style="margin-top:18px"><a class="link-accent" href={topic.mapQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(topic.mapQuery)}` : mapsUrl} target="_blank" rel="noopener noreferrer">{labels.map}</a></p>

      <div class="intro-body" style="margin-top:34px">
        {
          topic.sections.map((s) => (
            <div class="card card-pad" style="margin-bottom:18px">
              <h3 style="margin:0 0 10px;font-size:1.3rem">{s.title}</h3>
              <p style="margin:0;color:var(--text-muted)">{s.text}</p>
            </div>
          ))
        }
      </div>

      {
        topic.venues && (
          <div style="margin-top:38px">
            <h2 class="section-title">{labels.venues}</h2>
            <p class="section-lead">{labels.venueIntro}</p>
            <div class="nearby-grid" style="margin-top:22px">
              {topic.venues.map((v) => (
                <div class="card card-pad nearby-card">
                  <div class="nearby-head">
                    <h3>{v.name}</h3>
                  </div>
                  <p style="margin:6px 0 0;color:var(--text-muted)">
                    <strong style="color:var(--heading)">{labels.area}:</strong> {v.area}
                  </p>
                  <p style="margin:6px 0 0;color:var(--text-muted)">{v.knownFor}</p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <div style="margin-top:44px;background:var(--surface-accent);border:1px solid var(--border);border-radius:var(--radius);padding:34px 28px">
        <h2 class="section-title">{labels.faq}</h2>
        <div class="faq-list" style="padding:0;border:0;background:transparent;box-shadow:none">
          {
            topic.faq.map((f) => (
              <div class="faq-item" style="padding:18px 4px">
                <h3 style="margin:0 0 8px;font-size:1.05rem;color:var(--heading);font-family:var(--font-body)">
                  {f.q}
                </h3>
                <p style="margin:0;color:var(--text-muted)">{f.a}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div style="margin-top:44px">
        <h2 class="section-title">{labels.more}</h2>
        <div class="guide-grid" style="margin-top:22px">
          {
            topic.related.map((slug) => {
              const rt = allTopics.find((x) => x.slug === slug);
              if (!rt) return null;
              return (
                <a class="card card-pad guide-card" href={`/${lang}/${slug}/`} style="display:block">
                  <div class="gc-ico" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M3 12h18M12 5l7 7-7 7" />
                    </svg>
                  </div>
                  <h3>{rt.title}</h3>
                  <p class="gt">{rt.metaDescription}</p>
                </a>
              );
            })
          }
        </div>
      </div>

      <p style="margin-top:34px">
        <a class="link-accent" href={`/${lang}/`}>&larr; {labels.back}</a>
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify([breadcrumbLd, faqLd, webPageLd])} />
</article>
