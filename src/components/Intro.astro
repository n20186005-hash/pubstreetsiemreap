---
import Icon from './Icon.astro';

const { messages: m, lang } = Astro.props as { messages: any; lang: 'en' | 'zh' | 'km' };
const intro = m.intro;
const links = {
  en: ['About this guide', 'Sources', 'Photo credits'],
  zh: ['关于本指南', '资料来源', '图片版权'],
  km: ['អំពីមគ្គទេសក៍', 'ប្រភពព័ត៌មាន', 'ប្រភពរូបភាព'],
}[lang];
---

<section class="section-padding" id="intro">
  <div class="container fade-up">
    <span class="eyebrow">{intro.eyebrow}</span>
    <h2 class="section-title">{intro.title}</h2>
    <p class="section-lead">{intro.description}</p>

    <div class="intro-body">
      <div class="fact-grid">
        {intro.facts.map((f: any) => (
          <div class="fact-item">
            <div class="ico"><Icon name={f.icon} size={22} /></div>
            <h4>{f.k}</h4>
            <p>{f.v}</p>
          </div>
        ))}
      </div>

      <div class="intro-cols">
        <div class="card card-pad">
          <h3>{intro.highlights.title}</h3>
          <ul class="list-check">
            {intro.highlights.items.map((it: any) => (
              <li>
                <Icon name="check" size={22} />
                <span>{it.text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="guide card card-pad">
          <p class="g-eyebrow">{intro.guide.eyebrow}</p>
          <p class="g-desc">{intro.guide.description}</p>
          <ul class="list-check">
            {intro.guide.items.map((it: any) => (
              <li>
                <Icon name="check" size={22} />
                <span>{it.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    <nav class="site-info-links" aria-label={links[0]}>
      <a href={`/${lang}/about-guide/`}>{links[0]}</a>
      <a href={`/${lang}/sources/`}>{links[1]}</a>
      <a href={`/${lang}/image-credits/`}>{links[2]}</a>
    </nav>
  </div>
</section>
