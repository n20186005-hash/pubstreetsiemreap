}[lang as 'en' | 'zh' | 'km'];
const cookieUi = {
  en: { analytics: 'Allow analytics', preferences: 'Remember preferences', optional: 'Optional', saved: 'Your choices have been saved. Reload to apply the new settings.', off: 'Optional cookies are disabled.', detail: 'Optional categories are off until you enable them. No advertising cookies are currently used.' },
  zh: { analytics: '允许访问分析', preferences: '记住网站偏好', optional: '可选择', saved: '已保存您的选择，刷新页面后生效。', off: '已关闭可选 Cookie。', detail: '可选 Cookie 默认关闭，只有您开启后才会生效。本站目前不使用广告 Cookie。' },
  km: { analytics: 'អនុញ្ញាតការវិភាគ', preferences: 'ចងចាំចំណូលចិត្ត', optional: 'ជាជម្រើស', saved: 'បានរក្សាទុកជម្រើសរបស់អ្នក។ សូមផ្ទុកទំព័រឡើងវិញ។', off: 'បានបិទ Cookie ជាជម្រើស។', detail: 'Cookie ជាជម្រើសត្រូវបានបិទជាលំនាំដើម។ គេហទំព័រនេះមិនប្រើ Cookie ផ្សាយពាណិជ្ជកម្មទេ។' }
}[lang as 'en' | 'zh' | 'km'];
---

<article class="legal-doc container fade-up">
  <a class="legal-back" href={`/${lang}/`}>{legal.backToSite}</a>

  <h1 class="legal-title">{doc.title}</h1>
  <p class="legal-updated">{doc.updated.replace('2026年7月','2026年11月').replace('July 2026','November 2026').replace('កក្កដា ឆ្នាំ២០២៦','វិច្ឆិកា ឆ្នាំ២០២៦')}</p>

  {page === 'cookie' ? (
    <>
      <p class="legal-lead">{doc.intro}</p>
      <div class="cookie-cats">
        {doc.categories.map((c: any) => (
          <div class={`cookie-cat state-${c.state}`}>
            <div class="cookie-cat-head">
              <h3>{c.name}</h3>
              <span class={`cookie-badge badge-${c.state === 'on' ? 'off' : c.state}`}>{c.state === 'on' ? cookieUi.optional : c.status}</span>
            </div>
            <p class="cookie-cat-desc">{c.desc}</p>
            {c.note && <p class="cookie-cat-note">{c.note}</p>}
          </div>
        ))}
      </div>
      <div class="cookie-manage">
        <h3>{doc.manageTitle}</h3>
        <p>{doc.manageText}</p>
        <p>{cookieUi.detail}</p>
      </div>
      <div class="cookie-controls">
        <label><input type="checkbox" id="cookie-analytics" /> {cookieUi.analytics}</label>
        <label><input type="checkbox" id="cookie-preferences" /> {cookieUi.preferences}</label>
      </div>
      <div class="cookie-actions">
        <button type="button" class="btn-cta btn-cta-primary" id="cookie-save">{doc.save}</button>
        <button type="button" class="btn-cta btn-cta-ghost" id="cookie-reject">{doc.rejectAll}</button>
      </div>
      <p class="cookie-feedback" id="cookie-feedback" role="status" aria-live="polite" data-saved={cookieUi.saved} data-rejected={cookieUi.off}></p>
    </>
  ) : (
    [...doc.sections, ...extra[page].map(([heading, body]) => ({ heading, body }))].map((s: any) => (
      <section class="legal-section">
        <h2>{s.heading}</h2>
        {s.body && <p>{s.body}</p>}
        {s.items && s.items.length > 0 && (
          <ul>
            {s.items.map((it: string) => <li>{it}</li>)}
          </ul>
        )}
      </section>
    ))
  )}
</article>

<script is:inline>
  (function () {
    var save = document.getElementById('cookie-save');
    var reject = document.getElementById('cookie-reject');
    var analytics = document.getElementById('cookie-analytics');
    var preferences = document.getElementById('cookie-preferences');
    var feedback = document.getElementById('cookie-feedback');
    try {
      var existing = JSON.parse(localStorage.getItem('cookie-consent') || '{}');
      if (analytics) analytics.checked = existing.analytics === true;
      if (preferences) preferences.checked = existing.preference === true;
    } catch (e) {}
    if (save) save.addEventListener('click', function () {
      try {
        localStorage.setItem('cookie-consent', JSON.stringify({ necessary: true, analytics: !!analytics.checked, preference: !!preferences.checked, marketing: false }));
      } catch (e) {}
      if (feedback) feedback.textContent = feedback.dataset.saved;
    });
    if (reject) reject.addEventListener('click', function () {
      try {
        localStorage.setItem('cookie-consent', JSON.stringify({ necessary: true, analytics: false, preference: false, marketing: false }));
      } catch (e) {}
      if (analytics) analytics.checked = false;
      if (preferences) preferences.checked = false;
      if (feedback) feedback.textContent = feedback.dataset.rejected;
    });
  })();
</script>
