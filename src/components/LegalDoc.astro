      ['ការវិភាគ និងជម្រើសរបស់អ្នក', 'ការវិភាគចរាចរណ៍ដំណើរការតែបន្ទាប់ពីអ្នកយល់ព្រមប៉ុណ្ណោះ។ អ្នកអាចដកការយល់ព្រមនៅទំព័រការកំណត់ Cookie បានគ្រប់ពេល។ វាបញ្ឈប់ការផ្ទុកការវិភាគនាពេលក្រោយ ប៉ុន្តែមិនលុបទិន្នន័យដែលភាគីទីបីបានដំណើរការរួចទេ។'],
      ['ផែនទី និងតំណភ្ជាប់ខាងក្រៅ', 'ពេលចុច Google Maps, OpenStreetMap ឬប្រភពខាងក្រៅផ្សេងទៀត អ្នកទៅកាន់សេវារបស់ភាគីទីបី ដែលមានគោលការណ៍ឯកជនភាពផ្ទាល់ខ្លួន។'],
      ['សុវត្ថិភាព កុមារ និងការធ្វើបច្ចុប្បន្នភាព', 'យើងយកចិត្តទុកដាក់លើសុវត្ថិភាពគេហទំព័រ ប៉ុន្តែមិនអាចធានាសុវត្ថិភាពដាច់ខាតបានទេ។ គេហទំព័រនេះមិនត្រូវបានរចនាឡើងជាពិសេសសម្រាប់កុមារឡើយ។'],
      ['ទំនាក់ទំនង និងការកែតម្រូវ', 'សម្រាប់សំណើឯកជនភាព ការកែតម្រូវ ឬការលុបទិន្នន័យ សូមសរសេរទៅ laupetter72@gmail.com និងបញ្ជាក់ទំព័រពាក់ព័ន្ធ។']
    ],
    terms: [
      ['ទំនួលខុសត្រូវរបស់អ្នកទស្សនា', 'យើងមិនលក់សំបុត្រ ការដឹកជញ្ជូន អាហារ ឬកន្លែងស្នាក់នៅទេ។ ម៉ោងបើក តម្លៃ និងសកម្មភាពអាចផ្លាស់ប្តូរ។ សូមផ្ទៀងផ្ទាត់ព័ត៌មានសំខាន់ៗដោយខ្លួនឯង និងគោរពច្បាប់ក្នុងតំបន់។'],
      ['ផែនទី ការវាយតម្លៃ និងភាគីទីបី', 'ផែនទី និងឯកសារយោងខាងក្រៅជាសេវារបស់អ្នកផ្តល់សេវាផ្សេងៗ។ ការវាយតម្លៃមិនមែនជាការធានា ឬការគាំទ្រពាណិជ្ជកម្មទេ។'],
      ['តំណភ្ជាប់ និងការប្រើប្រាស់ឡើងវិញ', 'អាចដកស្រង់សេចក្តីសង្ខេបខ្លីនៃអត្ថបទដើមដោយបញ្ជាក់ប្រភព និងតំណភ្ជាប់។ កុំសន្មតថាគេហទំព័រនេះអាចផ្តល់អាជ្ញាបណ្ណបន្តសម្រាប់រូបថតភាគីទីបី។'],
      ['ការកែប្រែ និងទំនាក់ទំនង', 'យើងអាចកែប្រែលក្ខខណ្ឌ និងកាលបរិច្ឆេទនៅទំព័រនេះ។ សម្រាប់សំណួរ សូមទាក់ទង laupetter72@gmail.com។']
    ]
