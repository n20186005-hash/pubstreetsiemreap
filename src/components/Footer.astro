---
const { messages: m, lang } = Astro.props as { lang: string; messages: any };
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-bottom footer-bottom-simple">
      <div class="footer-copyright">
        <p>{m.footer.copyright}</p>
        <p>{m.footer.independentNotice}</p>
      </div>
      <nav class="footer-legal" aria-label="legal">
        <a href={`/${lang}/privacy-policy/`}>{m.legal.privacy.title}</a>
        <a href={`/${lang}/terms-of-service/`}>{m.legal.terms.title}</a>
        <a href={`/${lang}/cookie-settings/`}>{m.legal.cookie.title}</a>
      </nav>
    </div>
  </div>
</footer>
